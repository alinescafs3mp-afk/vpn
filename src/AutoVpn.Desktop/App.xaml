<Application x:Class="AutoVpn.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PaperBrush" Color="#F3F0E8"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1C1917"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#57534E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6F5B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFCF7"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E7E0D4"/>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
  </Application.Resources>
</Application>

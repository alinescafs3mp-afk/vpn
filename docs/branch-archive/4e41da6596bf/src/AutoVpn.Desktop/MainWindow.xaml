<Window x:Class="AutoVpn.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoVPN" Height="640" Width="880" MinHeight="560" MinWidth="720"
        Background="{StaticResource PaperBrush}" FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}">
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
      <TextBlock Text="AutoVPN" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Windows-клиент · V3" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
      <Button Content="Подключение" Click="ShowConnection" Style="{StaticResource NavButton}"/>
      <Button Content="Серверы" Click="ShowServers" Style="{StaticResource NavButton}"/>
      <Button Content="Подписки" Click="ShowSubscriptions" Style="{StaticResource NavButton}"/>
      <Button Content="Настройки" Click="ShowSettings" Style="{StaticResource NavButton}"/>
    </StackPanel>
    <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="28" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <Grid>
        <StackPanel x:Name="ConnectionPage">
          <TextBlock x:Name="PhaseText" Text="Не подключён" FontSize="32" FontWeight="SemiBold"/>
          <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,12,0,20" Foreground="{StaticResource MutedBrush}" Text="Служба ещё не вызывалась. Доступность серверов не измерялась."/>
          <CheckBox x:Name="DisclosureBox" Margin="0,0,0,16" Checked="DisclosureConsentChanged" Unchecked="DisclosureConsentChanged">
            <TextBlock TextWrapping="Wrap" MaxWidth="520" Text="AutoVPN подключается к публичным серверам из стороннего списка. Их операторы не проверяются. Поставщик подписки видит запросы на скачивание, а проверки серверов обращаются к публичным адресам. Приложение не обещает анонимность. Обычный HTTPS по-прежнему нужен."/>
          </CheckBox>
          <ComboBox x:Name="LiveMode" SelectedIndex="0" Margin="0,0,0,10" HorizontalAlignment="Left" Width="320">
            <ComboBoxItem Content="Прокси для приложений (без прав администратора)"/>
            <ComboBoxItem Content="TUN всего компьютера (экспериментально)"/>
          </ComboBox>
          <TextBlock x:Name="SelectedServerText" Text="Сервер: автоматический выбор" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Button x:Name="ConnectButton" Content="Подключить" Width="180" Height="44" HorizontalAlignment="Left" Click="ConnectLiveClick"/>
          <TextBlock Margin="0,24,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="V3: реальный прокси-сеанс. TUN требует отдельного согласия и UAC. Аварийная блокировка при падении ядра ещё не готова; режим не предназначен для чувствительного трафика."/>
        </StackPanel>
        <StackPanel x:Name="ServersPage" Visibility="Collapsed">
          <TextBlock Text="Серверы" FontSize="28" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
            <Button Content="Рабочие" Margin="0,0,8,0" Click="ShowWorking"/>
            <Button Content="Избранное" Margin="0,0,8,0" Click="ShowFavorites"/>
            <Button Content="Все" Click="ShowAll"/>
          </StackPanel>
          <TextBlock x:Name="MaintenanceStatus" Text="Ожидание запуска проверок." Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <Button x:Name="PauseChecksButton" Content="Приостановить проверки" Click="PauseChecksClick" HorizontalAlignment="Left" Margin="0,0,0,12"/>
          <ListBox x:Name="ServerRows" DisplayMemberPath="Caption" Height="180" SelectionChanged="ServerSelectionChanged"/>
          <WrapPanel Margin="0,8,0,8">
            <Button Content="Проверить выбранный" Click="VerifySelectedClick" Margin="0,0,8,4"/>
            <Button Content="Избранное ★" Click="ToggleFavoriteClick" Margin="0,0,8,4"/>
            <Button Content="Импорт из файла" Click="ImportFileClick" Margin="0,0,8,4"/>
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="60">
            <TextBlock x:Name="ServerList" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Рабочие серверы появятся после локальной проверки. Страна из названия не является измеренной геолокацией."/>
          </ScrollViewer>
        </StackPanel>
        <StackPanel x:Name="SubscriptionsPage" Visibility="Collapsed">
          <TextBlock Text="Подписки" FontSize="28" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
            <Button Content="Обновить подписки" Margin="0,0,8,0" Click="RefreshClick"/>
            <Button Content="Отменить загрузку" Click="CancelRefreshClick"/>
          </StackPanel>
          <TextBlock x:Name="SubscriptionStatus" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Обновление ещё не запускалось."/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Источник: igareck/vpn-configs-for-russia. Данные подписки не исполняются как конфиг. Интервал обновления минимум 15 минут. Проверки доступности выполняются отдельно; их можно приостановить во вкладке «Серверы»."/>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Margin="0,12,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Обновление по умолчанию: 120 минут ±10. Защита при обрыве рекомендуется. Для экспериментального TUN V3 нужно явно отключить этот флаг и подтвердить предупреждение при подключении."/>
          <CheckBox x:Name="ProtectionBox" Content="Защита при обрыве" Margin="0,8,0,8" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          <CheckBox x:Name="LanBox" Content="Разрешить доступ к локальной сети" Margin="0,0,0,8" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          <CheckBox x:Name="InsecureBox" Content="Разрешить серверы без проверки сертификата" Margin="0,0,0,8" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Закрытие окна прячет его в область уведомлений. Выход — из меню значка."/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
